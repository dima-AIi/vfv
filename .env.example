# DevOS environment configuration template.
# Copy to .env for local use. Never commit real secrets.

APP_NAME=DevOS
APP_ENV=local
APP_VERSION=0.1.0

# SQLAlchemy async database URL.
# Local MVP prototype default (SQLite):
DATABASE_URL=sqlite+aiosqlite:///devos.db
# Approved production stack target (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://devos:devos@localhost:5432/devos

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devos
POSTGRES_USER=devos
POSTGRES_PASSWORD=change-me

SECRET_KEY=generate-a-local-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

VITE_API_URL=http://localhost:8000

# AI provider: mock | anthropic (future)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# Files module local storage (replaceable via FileStorage protocol).
# Default: <repo>/storage. Must stay outside any public/web directory.
STORAGE_DIR=storage
FILE_MAX_BYTES=25000000
