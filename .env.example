# DevOS environment configuration template.
# Copy to .env for local use. Never commit real secrets.

APP_NAME=DevOS
APP_ENV=local
APP_VERSION=0.1.0

# SQLAlchemy async database URL.
# Local MVP prototype default (SQLite):
DATABASE_URL=sqlite+aiosqlite:///devos.db
# Approved production stack target (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://devos:devos@localhost:5432/devos

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devos
POSTGRES_USER=devos
POSTGRES_PASSWORD=change-me

SECRET_KEY=generate-a-local-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

VITE_API_URL=http://localhost:8000

# AI provider: mock | openai_compatible
AI_PROVIDER=mock

# OpenAI-compatible chat completions provider (free-tier endpoints).
# Required only when AI_PROVIDER=openai_compatible; never put real keys in Git.
# Examples of base URLs:
#   Groq:    https://api.groq.com/openai/v1
#   NVIDIA:  https://integrate.api.nvidia.com/v1
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama:  http://localhost:11434/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30

ANTHROPIC_API_KEY=

# Files module local storage (replaceable via FileStorage protocol).
# Default: <repo>/storage. Must stay outside any public/web directory.
STORAGE_DIR=storage
FILE_MAX_BYTES=25000000
